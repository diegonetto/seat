#!/usr/bin/env bash
# Start panes first, then link their HAPI sessions through the normal wake path.
# `dkt seats --names` is the startup list, one seat per line: docket decides which seats it names, and this script
# never re-filters it.
set -euo pipefail
names="$(dkt seats --names)"
mapfile -t seats <<<"$names"
script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
failed=0
for seat in "${seats[@]}"; do
  [ -n "$seat" ] || continue
  if ! seat up "$seat"; then
    failed=1
  fi
done
# Wake is serial, by seat name: the shared role-wake.lock answers busy rather than queuing.
for seat in "${seats[@]}"; do
  [ -n "$seat" ] || continue
  if result="$("$script_dir/seat-role" wake "$seat")"; then
    :
  else
    failed=1
  fi
  printf '%s %s\n' "$seat" "$result"
done
exit "$failed"
